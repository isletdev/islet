      "statements": [
        {
          "sql": "CREATE FUNCTION bump() RETURNS trigger AS $$\nBEGIN\n  NEW.updated_at := now();\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql",
          "start": 0,
          "end": 116,
          "line": 1,
          "kind": "ddl"
        },
