    {
      "name": "nested block comment, postgres",
      "note": "a scanner that does not nest stops at the first */ and reads 'c */ SELECT 1' as SQL",
      "engine": "postgres",
      "doc": "/* a /* b; */ c */ SELECT 1;SELECT 2",
      "statements": [
        {
          "sql": "SELECT 1",
          "start": 19,
          "end": 27,
          "line": 1,
          "kind": "read"
        },
        {
          "sql": "SELECT 2",
          "start": 28,
          "end": 36,
          "line": 1,
          "kind": "read"
        }
      ]
