{
  "note": "Shared corpus for the SQL statement splitter. The Go implementation in internal/sqlclient and the CodeMirror parse-tree walker in the web app are both tested against this file so they cannot drift. start and end are BYTE offsets into the UTF-8 encoding of doc, and doc[start:end] is exactly sql.",
  "cases": [
    {
      "name": "empty",
      "engine": "postgres",
      "doc": "",
      "statements": []
    },
    {
      "name": "whitespace only",
      "engine": "postgres",
      "doc": "   \n\t\n  ",
      "statements": []
    },
    {
      "name": "comment only",
      "engine": "postgres",
      "doc": "-- nothing to run here\n/* nor here */\n",
      "statements": []
    },
    {
      "name": "bare semicolons",
      "engine": "postgres",
      "doc": ";;\n;",
      "statements": []
    },
    {
      "name": "single statement, no terminator",
      "engine": "postgres",
      "doc": "SELECT 1",
      "statements": [
        {
          "sql": "SELECT 1",
          "start": 0,
          "end": 8,
          "line": 1,
          "kind": "read"
        }
      ]
    },
    {
      "name": "two statements",
      "engine": "postgres",
      "doc": "SELECT 1;\nSELECT 2;",
      "statements": [
        {
          "sql": "SELECT 1",
          "start": 0,
          "end": 8,
          "line": 1,
          "kind": "read"
        },
        {
          "sql": "SELECT 2",
          "start": 10,
          "end": 18,
          "line": 2,
          "kind": "read"
        }
      ]
    },
    {
      "name": "trailing text after the last semicolon",
      "engine": "postgres",
      "doc": "SELECT 1;\nSELECT 2",
      "statements": [
        {
          "sql": "SELECT 1",
          "start": 0,
          "end": 8,
          "line": 1,
          "kind": "read"
        },
        {
          "sql": "SELECT 2",
          "start": 10,
          "end": 18,
          "line": 2,
          "kind": "read"
        }
      ]
    },
    {
      "name": "leading and trailing gap is outside the range",
      "engine": "postgres",
      "doc": "\n  -- run me\n  SELECT 1 ;  \n",
      "statements": [
        {
          "sql": "SELECT 1",
          "start": 15,
          "end": 23,
          "line": 3,
          "kind": "read"
        }
      ]
    },
