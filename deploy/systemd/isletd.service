[Unit]
Description=Islet server panel
Documentation=https://islet.dev
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/isletd
Environment=ISLET_DATA_DIR=/var/lib/islet
Environment=ISLET_LISTEN=0.0.0.0:9443
Restart=always
RestartSec=2
# Only the daemon is killed on stop or restart, never the rest of its control
# group. Workspaces put an agent under tmux precisely so `islet update` cannot
# end it, and the default (KillMode=control-group) SIGTERMs every process in
# the unit's cgroup — tmux included, since isletd started it. Daemonizing does
# not help: systemd kills by cgroup, not by process tree.
KillMode=process
LimitNOFILE=65536
# isletd manages the host, so it runs as root and drops privileges per
# operation. These keep the blast radius small without breaking that.
NoNewPrivileges=no
ProtectKernelTunables=no
# PrivateTmp is deliberately off. It gives the unit a /tmp of its own, and
# systemd destroys that one and builds another on every restart — so a workspace
# that survives the restart (which is the entire point of KillMode=process
# above) is left holding a mount whose backing directory is gone, and anything
# in it that touches /tmp fails with ENOENT. It bought little here in any case:
# isletd runs as root with the Docker socket, so an attacker who can make it
# write to /tmp can already do far worse.
PrivateTmp=no
UMask=0027

[Install]
WantedBy=multi-user.target
