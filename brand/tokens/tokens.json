{
  "name": "Islet",
  "version": "2.0.0",
  "color": {
    "neutral": {
      "bg": { "light": "#FFFFFF", "dark": "#0A0A0A", "role": "Page" },
      "surface": { "light": "#FAFAFA", "dark": "#141414", "role": "Cards, panels, sidebar" },
      "surface2": { "light": "#F5F5F5", "dark": "#1C1C1C", "role": "Nested surfaces, table stripes" },
      "border": { "light": "#E5E5E5", "dark": "#262626", "role": "Hairlines" },
      "borderStrong": { "light": "#8A8A8A", "dark": "#666666", "role": "Inputs, 3:1" },
      "ink": { "light": "#0A0A0A", "dark": "#FAFAFA", "role": "Primary text, primary buttons" },
      "inkMuted": { "light": "#6B6B6B", "dark": "#A3A3A3", "role": "Secondary text" },
      "inkFaint": { "light": "#A3A3A3", "dark": "#6B6B6B", "role": "Placeholders, disabled. Never information" }
    },
    "accent": {
      "accent": { "light": "#0A5BFF", "dark": "#4D8DFF", "role": "Links, focus ring, selected. Not decoration" },
      "accentStrong": { "light": "#0047D6", "dark": "#7AA8FF" },
      "accentSoft": { "light": "#EAF1FF", "dark": "#10213F" }
    },
    "semantic": {
      "success": { "light": "#15803D", "dark": "#4ADE80" },
      "successSoft": { "light": "#E7F6EC", "dark": "#0F2A1A" },
      "warning": { "light": "#A16207", "dark": "#FBBF24" },
      "warningSoft": { "light": "#FDF3DC", "dark": "#2E2410" },
      "danger": { "light": "#DC2626", "dark": "#F87171" },
      "dangerSoft": { "light": "#FDE8E8", "dark": "#341515" }
    },
    "code": { "bg": "#0A0A0A", "fg": "#FAFAFA", "muted": "#A3A3A3", "accent": "#4D8DFF", "warn": "#FBBF24", "error": "#F87171" }
  },
  "typography": {
    "fontFamily": {
      "sans": { "value": "Geist", "fallback": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "license": "SIL OFL 1.1", "axes": { "wght": [100, 900] } },
      "mono": { "value": "Geist Mono", "fallback": "ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace", "license": "SIL OFL 1.1", "axes": { "wght": [100, 900] } }
    },
    "fontSize": { "xs": "12px", "sm": "13px", "md": "14px", "base": "16px", "lg": "18px", "xl": "22px", "2xl": "28px", "3xl": "44px" },
    "lineHeight": { "tight": 1.15, "normal": 1.45, "relaxed": 1.6 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "roles": {
      "panelBody": { "family": "sans", "size": "sm", "weight": 400 },
      "pageTitle": { "family": "sans", "size": "xl", "weight": 600, "tracking": "-0.02em" },
      "metric": { "family": "sans", "size": "2xl", "weight": 600, "tracking": "-0.02em", "numeric": "tabular-nums" },
      "code": { "family": "mono", "size": "sm", "weight": 400 },
      "wordmark": { "family": "sans", "weight": 600, "text": "Islet" }
    }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px" },
  "radius": { "sm": "4px", "md": "6px", "lg": "10px", "full": "9999px" },
  "motion": { "fast": "100ms", "normal": "160ms", "slow": "240ms", "ease": "cubic-bezier(0.2, 0, 0, 1)" },
  "logo": {
    "mark": {
      "geometry": "100 box. Mainland: M4 22 H50 V50 H78 V96 H4 Z. Fragment: square x62 y6 w34 h34. Gutter 12 left, 10 below the fragment",
      "colour": "Single colour only: black on light, white on dark. Never the accent",
      "minSize": "16px",
      "clearSpace": "0.5 x mark height"
    },
    "wordmark": { "text": "Islet", "font": "Geist 600", "case": "Title case" },
    "lockup": { "markHeight": "1.04 x cap height", "gap": "0.30 x cap height" },
    "appIcon": { "background": "#000000", "foreground": "#FFFFFF", "markScale": 0.60, "adaptiveForegroundScale": 0.48, "maskableScale": 0.42, "radiusPreview": 22 }
  },
  "tagline": "Own your infrastructure."
}
